{
  "name": "microbe-life",
  "version": "0.5.0",
  "description": "Particle life as small microbial creatures: one typed-array core for a web background and an Aether node.",
  "type": "module",
  "main": "src/core.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "bench": "node bench/bench.js",
    "build": "node build.js",
    "scan": "node bench/scan.js",
    "thumbs": "node bench/thumbs.js dist/thumbs",
    "cyjs": "node bench/cyjs.js dist/cyjs",
    "prepublishOnly": "node build.js && node --test test/*.test.js"
  },
  "author": "David Bovill",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/microbe-life.git"
  },
  "homepage": "https://night.earth/view/microbe-life-plan",
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/microbe-life/issues"
  },
  "keywords": [
    "particle-life",
    "generative",
    "aether",
    "audioworklet",
    "microbes"
  ],
  "files": [
    "src",
    "wrappers",
    "bench",
    "test",
    "build.js",
    "dist/microbe-bg.min.js",
    "dist/microbe-steer.js",
    "dist/microbe-arena.js",
    "dist/microbe-life.aethernode",
    "dist/node",
    "dist/microbe-life-demo.html",
    "dist/bg-test.html",
    "dist/arena-test.html"
  ],
  "exports": {
    ".": "./src/core.js",
    "./colonies": "./src/colonies.js",
    "./classic": "./src/classic.js",
    "./genome": "./src/genome.js",
    "./genomes": "./src/genomes.js",
    "./map": "./src/map.js",
    "./draw2d": "./src/draw2d.js",
    "./glow": "./src/glow.js",
    "./cyjs": "./src/cyjs.js",
    "./rng": "./src/rng.js",
    "./package.json": "./package.json"
  }
}
